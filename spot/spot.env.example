# spot.env.example — every knob the on-box scripts read.
#
# install-box.sh writes the live copy to $SPOT_PREFIX/env from its own
# environment; a project normally sets these in its provisioner rather than
# copying this file. Unset means "use the script's default", shown here.
#
# NO SECRETS. This file is world-readable on the box so the box user can source
# it. Credentials come from the instance role (S3, EC2) and from the box user's
# ~/.ssh (the git deploy key).

# --- required ---------------------------------------------------------------
REPO=/home/ubuntu/src/myproject      # the checkout on the box
BUCKET=my-build-bucket               # S3 bucket that dumps and notes go to

# --- where things land ------------------------------------------------------
WORK_BRANCH=main                     # branch the box pushes COMMITTED work to
AUTOSAVE_PREFIX=s3://my-build-bucket/autosave   # crash dumps
S3_PREFIX=s3://my-build-bucket/spot             # notes + build logs
NOTES_DIR=/var/tmp/spot-notes        # on-box scratch for both
# Where the bundle is built before upload. Point it at a roomier volume if the
# box's /tmp is small -- a dump that cannot be written is work about to be lost,
# and preserve.sh will say so loudly rather than reporting nothing to save.
AUTOSAVE_BUNDLE_DIR=/tmp

# --- what the autosave commit looks like ------------------------------------
# Make these greppable: they are how you later detect one of these commits
# having reached a branch it should not have.
AUTOSAVE_AUTHOR_NAME=spot-autosave
AUTOSAVE_AUTHOR_EMAIL=autosave@spot.local
AUTOSAVE_SUBJECT_PREFIX=wip: autosave on

# Submodule pointers are never autosaved (a stale box reverts pins otherwise).
# Paths normally come from .gitmodules; set this only if that is unreadable.
SPOT_SUBMODULE_PATHS=

# --- idle auto-terminate ----------------------------------------------------
IDLE_SECONDS=1800                    # idle time before the box terminates itself
IDLE_LOAD_FLOOR=0.5                  # 1-min load at or above this counts as busy
#
# THE SETTING THAT DESTROYS WORK IF YOU GET IT WRONG. List the process that does
# the WAITING, not just the one that does the work: a low-CPU, network-bound,
# long-running job is invisible to both this check and a CloudWatch CPU alarm.
# iospharo lost a 74-minute sweep to exactly that (see idle-shutdown.sh).
IDLE_ACTIVE_PATTERN=cmake|cc1plus|make|ninja|clang|gcc|node|claude|git 
IDLE_STAMP=/var/lib/spot-last-active

# --- install layout ---------------------------------------------------------
SPOT_PREFIX=/opt/spot                # where the scripts and this env live
SPOT_USER=ubuntu                     # owns the checkout and the deploy key
